---
export type NavKey = 'services' | 'approach' | 'insights' | 'about';

export type Props = {
  current?: NavKey;
};

const { current } = Astro.props;

const links: { key: NavKey; href: string; label: string }[] = [
  { key: 'services', href: '/services', label: 'What we do' },
  { key: 'approach', href: '/approach', label: 'How we work' },
  { key: 'insights', href: '/insights', label: 'Insights' },
  { key: 'about', href: '/about', label: 'About' },
];
---

<header class="site-header on-dark">
  <div class="wrap header-row">
    <a class="wordmark" href="/" aria-label="Avisé & Co., home">Avisé <span class="amp" aria-hidden="true">&amp;</span> Co.</a>
    <button class="btn btn--outline btn--sm menu-btn" id="menuBtn" aria-expanded="false" aria-controls="siteNav">Menu</button>
    <nav class="nav" id="siteNav" aria-label="Main">
      {
        links.map((link) => (
          <a class="nav-link" href={link.href} aria-current={link.key === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn--act btn--sm" href="/contact">Book a free consult</a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menuBtn')!;
  const siteNav = document.getElementById('siteNav')!;
  menuBtn.addEventListener('click', () => {
    const open = !siteNav.classList.contains('open');
    siteNav.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.textContent = open ? 'Close' : 'Menu';
  });
</script>
