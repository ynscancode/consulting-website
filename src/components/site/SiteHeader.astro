---
import { ed, siteContent, siteLink } from '../../lib/editable';

export type NavKey = 'services' | 'approach' | 'insights' | 'about';
export type Ground = 'forest' | 'paper' | 'rose' | 'ink';

export type Props = {
  current?: NavKey;
  /** Ground of the first band, so the header starts in the right colours before the script runs. */
  ground?: Ground;
  /** Contact page: no header call to action at all. */
  hideCta?: boolean;
};

const { current, ground = 'forest', hideCta = false } = Astro.props;
const c = siteContent(Astro.locals);
// The call to action only ever hides at the top of the home page, where the
// hero has its own "Book a free consult" (see the script). Everywhere else it
// renders visible, so it never fades in on load.
const isHome = ['/', '/edit', '/edit/'].includes(Astro.url.pathname);
const ctaState = hideCta ? 'none' : isHome ? 'off' : 'on';

const links: { key: NavKey; href: string; label: string }[] = [
  { key: 'services', href: '/services', label: 'What we do' },
  { key: 'approach', href: '/approach', label: 'How we work' },
  { key: 'insights', href: '/insights', label: 'Insights' },
  { key: 'about', href: '/about', label: 'About' },
];
---

<header class="site-header on-dark" data-ground={ground} data-cta={ctaState}>
  <div class="wrap header-row">
    <a class="wordmark" href={siteLink(Astro.locals, '/')} aria-label="Avisé & Co., home">Avisé <span class="amp" aria-hidden="true">&amp;</span> Co.</a>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="siteNav">Menu</button>
    <nav class="nav" id="siteNav" aria-label="Main">
      {
        links.map((link) => (
          <a class="nav-link" href={siteLink(Astro.locals, link.href)} aria-current={link.key === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn--act btn--sm nav-cta" href={siteLink(Astro.locals, '/contact')} {...ed(Astro.locals, 'header.cta')}>{c.header.cta}</a>
    </nav>
  </div>
</header>

<script>
  // The header has no bar of its own: it takes the ground of the band under its
  // bottom edge (solid ink while the phone menu is open). On the home page it
  // hides its call to action while the hero's own buttons are on screen.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const menuBtn = document.getElementById('menuBtn')!;
  const siteNav = document.getElementById('siteNav')!;

  const GROUNDS = ['forest', 'paper', 'rose', 'ink'];
  function groundAt(y: number): string {
    for (const band of document.querySelectorAll('.band')) {
      const r = band.getBoundingClientRect();
      if (r.height && r.top <= y && r.bottom > y) {
        const g = GROUNDS.find((name) => band.classList.contains('band--' + name));
        if (g) return g;
      }
    }
    return 'paper';
  }

  function updateHeader() {
    // Sample 1px below the header's bottom edge, not on it: at the top of a page
    // that edge is exactly where the first band starts, and fractional zoom can
    // round the two apart so that no band "contains" it (which fell back to paper
    // on pages that open on forest).
    const ground = header.hasAttribute('data-menu') ? 'ink' : groundAt(header.getBoundingClientRect().bottom + 1);
    header.setAttribute('data-ground', ground);
    document.body.style.setProperty('--safe-bg', 'var(--' + ground + ')');
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        updateHeader();
      });
    },
    { passive: true }
  );
  window.addEventListener('resize', updateHeader);
  // Re-check once layout settles (stylesheets, fonts) and when the page comes
  // back from the back/forward cache, none of which fire a scroll event.
  window.addEventListener('load', updateHeader);
  window.addEventListener('pageshow', updateHeader);
  document.fonts?.ready.then(updateHeader);
  if ('ResizeObserver' in window) new ResizeObserver(updateHeader).observe(document.body);
  updateHeader();

  /* Call to action: on the home page only, hidden while the hero's buttons
     are in view (they'd duplicate it); the server rendered it "off" there.
     Every other page renders it "on" (or "none" on contact) and leaves it. */
  const heroCta = document.getElementById('heroCta');
  if (heroCta && header.getAttribute('data-cta') === 'off') {
    if ('IntersectionObserver' in window) {
      // The hero's row sits right under the header at load, so don't count the header's own strip.
      new IntersectionObserver(
        (entries) => header.setAttribute('data-cta', entries[0].isIntersecting ? 'off' : 'on'),
        { rootMargin: '-72px 0px 0px 0px' }
      ).observe(heroCta);
    } else {
      header.setAttribute('data-cta', 'on');
    }
  }

  menuBtn.addEventListener('click', () => {
    const open = !siteNav.classList.contains('open');
    siteNav.classList.toggle('open', open);
    header.toggleAttribute('data-menu', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.textContent = open ? 'Close' : 'Menu';
    updateHeader();
  });
</script>
