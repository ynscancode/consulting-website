---
import { textHtml } from '../../lib/richText';
import { ed, edItem, edList } from '../../lib/editable';

export type Props = {
  items: { q: string; a: string }[];
  /** Dot path of `items` in avise.json. */
  path: string;
};

const { items, path } = Astro.props;
const L = Astro.locals;
---

<div class="faq" {...edList(L, path)}>
  {
    items.map((f, i) => (
      <details {...edItem(L, i)}>
        <summary {...ed(L, `${path}.${i}.q`)} set:html={textHtml(f.q)} />
        <p {...ed(L, `${path}.${i}.a`)} set:html={textHtml(f.a)} />
      </details>
    ))
  }
</div>
