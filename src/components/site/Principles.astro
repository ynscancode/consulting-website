---
import { ed, edItem, edList } from '../../lib/editable';
import { richHtml } from '../../lib/richText';
import type { AviseContent } from '../../lib/aviseContent';

export type Props = {
  principles: AviseContent['principles'];
  /** Stack in one column (the About page) instead of the two-column grid. */
  single?: boolean;
};

const { principles, single } = Astro.props;
const L = Astro.locals;
---

<div class="principles" style={single ? 'grid-template-columns:minmax(0,1fr)' : undefined} {...edList(L, 'principles')}>
  {
    principles.map((p, i) => (
      <div class="principle" {...edItem(L, i)}>
        <h3 class="d-xs" {...ed(L, `principles.${i}.t`, 'rich')} set:html={richHtml(p.t)} />
        <p class="body-s" style="color:var(--ink-muted)" {...ed(L, `principles.${i}.b`)}>
          {p.b}
        </p>
      </div>
    ))
  }
</div>
