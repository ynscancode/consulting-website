---
import { ed, edItem, edList, siteContent, siteLink } from '../../lib/editable';
import { richHtml } from '../../lib/richText';

export type Props = {
  showCta?: boolean;
};

const { showCta = true } = Astro.props;
const L = Astro.locals;
const f = siteContent(L).footer;
---

<footer class="band band--forest on-dark" id="footer">
  <div class="wrap">
    {
      showCta && (
        <div class="cta-inner" id="ctaBlock">
          <div class="stack">
            <h2 class="d-l" {...ed(L, 'footer.ctaHeadline', 'rich')} set:html={richHtml(f.ctaHeadline, { emClass: true })} />
            <p class="lede muted" {...ed(L, 'footer.ctaLede')}>{f.ctaLede}</p>
          </div>
          <a class="btn btn--act" href={siteLink(L, '/contact')} {...ed(L, 'footer.ctaButton')}>
            {f.ctaButton}
          </a>
        </div>
      )
    }
    <div class="foot">
      <div class="stack" style="gap:var(--space-2)">
        <a class="wordmark" href={siteLink(L, '/')} aria-label="Avisé & Co., home">Avisé <span class="amp" aria-hidden="true">&amp;</span> Co.</a>
        <p class="body-s muted" {...ed(L, 'footer.tagline')}>{f.tagline}</p>
      </div>
      <ul>
        <li><a href={siteLink(L, '/services')}>What we do</a></li>
        <li><a href={siteLink(L, '/approach')}>How we work</a></li>
        <li><a href={siteLink(L, '/insights')}>Insights</a></li>
        <li><a href={siteLink(L, '/about')}>About</a></li>
      </ul>
      <ul {...edList(L, 'footer.contact')}>
        {f.contact.map((line, i) => <li class="muted" {...edItem(L, i)} {...ed(L, `footer.contact.${i}`)}>{line}</li>)}
      </ul>
    </div>
    <div class="foot-base">
      <p class="caption muted" {...ed(L, 'footer.legal')}>{f.legal}</p>
      <p class="caption muted" {...ed(L, 'footer.note')}>{f.note}</p>
    </div>
  </div>
</footer>
