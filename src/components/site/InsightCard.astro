---
import { textHtml } from '../../lib/richText';
import { ed, edItem, siteContent, siteLink } from '../../lib/editable';
import type { Insight } from '../../lib/aviseContent';

export type Props = {
  insight: Insight;
  /** Position in the insights list (the editor's paths). */
  index: number;
};

const { insight, index } = Astro.props;
const L = Astro.locals;
const footer = siteContent(L).insightsPage.cardFooter;
---

<a
  class={insight.tone === 'forest' ? 'card card--forest' : 'card'}
  href={siteLink(L, `/insights/${insight.id}`)}
  data-sector={insight.sector}
  {...edItem(L, index)}
>
  <span class="card__meta" {...ed(L, `insights.${index}.meta`)} set:html={textHtml(insight.meta)} />
  <span class="card__headline" {...ed(L, `insights.${index}.headline`)} set:html={textHtml(insight.headline)} />
  <span class="card__footer">{footer}</span>
</a>
