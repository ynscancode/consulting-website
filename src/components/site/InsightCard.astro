---
import type { Insight } from '../../lib/aviseContent';

export type Props = {
  insight: Insight;
};

const { insight } = Astro.props;
---

<a
  class={insight.tone === 'forest' ? 'card card--forest' : 'card'}
  href={`/insights/${insight.id}`}
  data-sector={insight.sector}
>
  <span class="card__meta">{insight.meta}</span>
  <span class="card__headline">{insight.headline}</span>
  <span class="card__footer">Read the analysis → &nbsp;·&nbsp; draft, figures pending</span>
</a>
