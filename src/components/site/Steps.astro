---
import { ed, edItem, edList } from '../../lib/editable';
import type { AviseContent } from '../../lib/aviseContent';

export type Props = {
  steps: AviseContent['steps'];
};

const { steps } = Astro.props;
const L = Astro.locals;
---

<ol class="steps" {...edList(L, 'steps')}>
  {
    steps.map((s, i) => (
      <li {...edItem(L, i)}>
        <span class="steps__num" aria-hidden="true">{i + 1}</span>
        <span class="steps__text">
          <span class="steps__title" {...ed(L, `steps.${i}.t`)}>{s.t}</span>
          <span class="steps__body" {...ed(L, `steps.${i}.b`)}>{s.b}</span>
          {s.tag && <span class="steps__tag" {...ed(L, `steps.${i}.tag`)}>{s.tag}</span>}
        </span>
      </li>
    ))
  }
</ol>
