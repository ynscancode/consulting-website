---
import Faq from '../Faq.astro';
import { ed, edItem, edList, siteContent } from '../../../lib/editable';
import { richHtml, textHtml } from '../../../lib/richText';

const L = Astro.locals;
const c = siteContent(L);
const p = c.servicesPage;
---

<section class="band band--forest band--tight on-dark">
  <div class="wrap page-hero">
    <p class="label" {...ed(L, 'servicesPage.label')} set:html={textHtml(p.label)} />
    <h1 class="d-xl" {...ed(L, 'servicesPage.headline', 'rich')} set:html={richHtml(p.headline, { emClass: true })} />
    <p class="lede" {...ed(L, 'servicesPage.lede')} set:html={textHtml(p.lede)} />
  </div>
</section>
<section class="band band--paper on-light">
  <div class="wrap">
    <div>
      {
        c.services.map((s, i) => (
          <div class="detail" id={`svc-${s.id}`}>
            <div class="stack">
              <h2 class="d-m" {...ed(L, `services.${i}.name`)} set:html={textHtml(s.name)} />
              <p class="lede" style="font-size:19px;color:var(--ink-muted)" {...ed(L, `services.${i}.short`)} set:html={textHtml(s.short)} />
            </div>
            <div class="detail__cols">
              <div>
                <h3 {...ed(L, 'servicesPage.whenTitle')} set:html={textHtml(p.whenTitle)} />
                <ul class="ticks" {...edList(L, `services.${i}.when`)}>
                  {s.when.map((item, j) => (
                    <li {...edItem(L, j)} {...ed(L, `services.${i}.when.${j}`)} set:html={textHtml(item)} />
                  ))}
                </ul>
              </div>
              <div>
                <h3 {...ed(L, 'servicesPage.getTitle')} set:html={textHtml(p.getTitle)} />
                <ul class="ticks" {...edList(L, `services.${i}.get`)}>
                  {s.get.map((item, j) => (
                    <li {...edItem(L, j)} {...ed(L, `services.${i}.get.${j}`)} set:html={textHtml(item)} />
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="dont">
      <div class="stack">
        <p class="label" {...ed(L, 'servicesPage.dontLabel')} set:html={textHtml(p.dontLabel)} />
        <h2 class="d-m" {...ed(L, 'servicesPage.dontHeadline', 'rich')} set:html={richHtml(p.dontHeadline, { emClass: true })} />
      </div>
      <div class="stack">
        <ul class="struck" {...edList(L, 'servicesPage.dont')}>
          {p.dont.map((item, j) => <li {...edItem(L, j)} {...ed(L, `servicesPage.dont.${j}`)} set:html={textHtml(item)} />)}
        </ul>
        <p class="body-s muted" {...ed(L, 'servicesPage.dontNote')} set:html={textHtml(p.dontNote)} />
      </div>
    </div>
  </div>
</section>
<section class="band band--paper on-light" style="padding-top:0">
  <div class="wrap split">
    <div class="stack">
      <p class="label" {...ed(L, 'servicesPage.pricingLabel')} set:html={textHtml(p.pricingLabel)} />
      <h2 class="d-m" {...ed(L, 'servicesPage.pricingHeadline', 'rich')} set:html={richHtml(p.pricingHeadline, { emClass: true })} />
      <p class="body-s muted" {...ed(L, 'servicesPage.pricingBody')} set:html={textHtml(p.pricingBody)} />
    </div>
    <Faq items={c.faqServices} path="faqServices" />
  </div>
</section>
