---
import Faq from '../Faq.astro';
import { ed, edItem, edList, isEditing, siteContent } from '../../../lib/editable';
import { richHtml, textHtml } from '../../../lib/richText';

const L = Astro.locals;
const c = siteContent(L);
const p = c.contactPage;

const editing = isEditing(L);
const c2 = { slotTimes: p.slotTimes, errors: p.errors, confirm: p.confirm, toastCopied: p.toastCopied, toastSelected: p.toastSelected };
// In the editor the form is inert, and its submit button and wrapper become
// plain elements with the same classes: iPad Safari shows no text cursor
// while editing a <button class="btn"> inside a <form>.
const FormTag = editing ? 'div' : 'form';
const SubmitTag = editing ? 'span' : 'button';
---

<section class="band band--forest band--tight on-dark">
  <div class="wrap page-hero">
    <p class="label" {...ed(L, 'contactPage.label')} set:html={textHtml(p.label)} />
    <h1 class="d-xl" {...ed(L, 'contactPage.headline', 'rich')} set:html={richHtml(p.headline, { emClass: true })} />
    <p class="lede" {...ed(L, 'contactPage.lede')} set:html={textHtml(p.lede)} />
  </div>
</section>
<section class="band band--paper on-light">
  <div class="wrap form-grid">
    <div id="formWrap">
      <FormTag id="consultForm" class="consult-form" novalidate={editing ? undefined : true}>
        <div class="field-row">
          <div class="field" id="f-name">
            <label for="name" {...ed(L, 'contactPage.nameLabel')} set:html={textHtml(p.nameLabel)} />
            <input id="name" name="name" autocomplete="name" />
            <span class="err" hidden></span>
          </div>
          <div class="field" id="f-biz">
            <label for="biz" {...ed(L, 'contactPage.bizLabel')} set:html={textHtml(p.bizLabel)} />
            <input id="biz" name="biz" autocomplete="organization" />
            <span class="err" hidden></span>
          </div>
        </div>
        <div class="field-row">
          <div class="field" id="f-type">
            <label for="type" {...ed(L, 'contactPage.typeLabel')} set:html={textHtml(p.typeLabel)} />
            <select id="type" name="type">
              <option value="">{p.typeChoose}</option>
              {p.businessTypes.map((t) => <option>{t}</option>)}
            </select>
            <span class="err" hidden></span>
          </div>
          <div class="field" id="f-contact">
            <label for="contact" {...ed(L, 'contactPage.contactLabel')} set:html={textHtml(p.contactLabel)} />
            <input id="contact" name="contact" autocomplete="email" placeholder={p.contactPlaceholder} />
            <span class="err" hidden></span>
          </div>
        </div>
        <div class="field" id="f-problem">
          <label for="problem" {...ed(L, 'contactPage.problemLabel')} set:html={textHtml(p.problemLabel)} />
          <span class="hint" {...ed(L, 'contactPage.problemHint')} set:html={textHtml(p.problemHint)} />
          <textarea id="problem" name="problem"></textarea>
          <span class="err" hidden></span>
        </div>
        <fieldset class="field" id="f-slot">
          <legend {...ed(L, 'contactPage.slotLegend')} set:html={textHtml(p.slotLegend)} />
          <span class="hint" {...ed(L, 'contactPage.slotHint')} set:html={textHtml(p.slotHint)} />
          <div class="slots" id="slots" role="radiogroup" aria-label="Available times"></div>
          <span class="err" hidden></span>
        </fieldset>
        <div class="btn-row">
          <SubmitTag class="btn btn--forest" type={editing ? undefined : 'submit'} {...ed(L, 'contactPage.submit')} set:html={textHtml(p.submit)} />
          <span class="caption" style="color:var(--ink-muted)" {...ed(L, 'contactPage.submitNote')} set:html={textHtml(p.submitNote)} />
        </div>
      </FormTag>
    </div>
    <aside class="aside">
      <div class="stack">
        <p class="label" {...ed(L, 'contactPage.messageLabel')} set:html={textHtml(p.messageLabel)} />
        <div class="handle"><code {...ed(L, 'contactPage.handle')} set:html={textHtml(p.handle)} /><button class="copy-btn" type="button" id="copyHandle" {...ed(L, 'contactPage.copyButton')} set:html={textHtml(p.copyButton)} /></div>
        <p class="body-s muted" {...ed(L, 'contactPage.messageBody')} set:html={textHtml(p.messageBody)} />
      </div>
      <div class="stack">
        <p class="label" {...ed(L, 'contactPage.nextLabel')} set:html={textHtml(p.nextLabel)} />
        <ul class="ticks" {...edList(L, 'contactPage.next')}>
          {p.next.map((item, i) => <li {...edItem(L, i)} {...ed(L, `contactPage.next.${i}`)} set:html={textHtml(item)} />)}
        </ul>
      </div>
      <Faq items={c.faqContact} path="faqContact" />
      {
        editing && (
          <div class="edit-extra" data-edit-extra>
            <p class="edit-extra__title">Form options (not editable on the page)</p>
            <div class="edit-extra__row">
              <label>First choice: <span data-edit="contactPage.typeChoose" data-edit-kind="text">{p.typeChoose}</span></label>
              <label>Placeholder: <span data-edit="contactPage.contactPlaceholder" data-edit-kind="text">{p.contactPlaceholder}</span></label>
            </div>
            <p class="edit-extra__note">Booking times, offered on each of the next four days (Sundays skipped):</p>
            <ul class="edit-extra__list" data-edit-list="contactPage.slotTimes">
              {p.slotTimes.map((t, i) => (
                <li data-edit-item={String(i)}>
                  <span data-edit={`contactPage.slotTimes.${i}`} data-edit-kind="text">{t}</span>
                </li>
              ))}
            </ul>
            <p class="edit-extra__note">Business types:</p>
            <ul class="edit-extra__list" data-edit-list="contactPage.businessTypes">
              {p.businessTypes.map((t, i) => (
                <li data-edit-item={String(i)}>
                  <span data-edit={`contactPage.businessTypes.${i}`} data-edit-kind="text">{t}</span>
                </li>
              ))}
            </ul>
            <p class="edit-extra__title">Messages shown when the form is used</p>
            {(
              [
                ['name', 'Name missing'],
                ['biz', 'Business name missing'],
                ['type', 'Type not chosen'],
                ['contact', 'Email or handle missing'],
                ['contactFormat', 'Email or handle not valid'],
                ['problem', 'Description too short'],
                ['slot', 'No time picked'],
              ] as const
            ).map(([key, label]) => (
              <div class="edit-extra__row">
                <span class="edit-extra__name">{label}</span>
                <span data-edit={`contactPage.errors.${key}`} data-edit-kind="text">{p.errors[key]}</span>
              </div>
            ))}
            <p class="edit-extra__title">After sending ({'{name}'} and {'{channel}'} are filled in)</p>
            {(
              [
                ['label', 'Label', 'text'],
                ['headline', 'Headline', 'rich'],
                ['body', 'Line under it', 'text'],
                ['channelEmail', 'Channel: email', 'text'],
                ['channelDm', 'Channel: Instagram', 'text'],
                ['lineBusiness', 'Receipt: business', 'text'],
                ['lineType', 'Receipt: type', 'text'],
                ['lineCall', 'Receipt: call', 'text'],
                ['lineAbout', 'Receipt: about', 'text'],
                ['lineCost', 'Receipt: cost', 'text'],
                ['costValue', 'Receipt: cost value', 'text'],
                ['finding', 'Receipt: finding', 'rich'],
                ['footer', 'Receipt: footer', 'text'],
                ['again', 'Button', 'text'],
              ] as const
            ).map(([key, label, kind]) => (
              <div class="edit-extra__row">
                <span class="edit-extra__name">{label}</span>
                {kind === 'rich' ? (
                  <span data-edit={`contactPage.confirm.${key}`} data-edit-kind="rich" set:html={richHtml(p.confirm[key])} />
                ) : (
                  <span data-edit={`contactPage.confirm.${key}`} data-edit-kind="text">{p.confirm[key]}</span>
                )}
              </div>
            ))}
            <p class="edit-extra__title">Copy-handle messages ({'{handle}'} is filled in)</p>
            <div class="edit-extra__row">
              <span class="edit-extra__name">Copied</span>
              <span data-edit="contactPage.toastCopied" data-edit-kind="text">{p.toastCopied}</span>
            </div>
            <div class="edit-extra__row">
              <span class="edit-extra__name">Couldn't copy</span>
              <span data-edit="contactPage.toastSelected" data-edit-kind="text">{p.toastSelected}</span>
            </div>
          </div>
        )
      }
    </aside>
    <script type="application/json" id="contactData" set:html={JSON.stringify(c2).replace(/</g, '\\u003c')} />
  </div>
</section>

<script>
  import { receiptHTML, escapeHtml } from '../../../lib/receipt';
  import { fill, richHtml, textHtml } from '../../../lib/richText';
  import { PREFILL_KEY } from '../../../lib/prefill';

  const msg = JSON.parse(document.getElementById('contactData')!.textContent!) as {
    slotTimes: string[];
    errors: Record<'name' | 'biz' | 'type' | 'contact' | 'contactFormat' | 'problem' | 'slot', string>;
    confirm: Record<string, string>;
    toastCopied: string;
    toastSelected: string;
  };
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));

  // The editor renders this page to edit its text: no interactivity there.
  const editingPage = document.documentElement.hasAttribute('data-editing');

  /* ---------- Booking slots: the next four days after today, Sundays skipped ---------- */
  const TIMES = msg.slotTimes;
  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const slotList: { day: string; time: string }[] = [];
  {
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    let days = 0;
    while (days < 4) {
      d.setDate(d.getDate() + 1);
      if (d.getDay() === 0) continue;
      const label = DAYS[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()];
      TIMES.forEach((t) => slotList.push({ day: label, time: t }));
      days++;
    }
  }
  // In the editor each time is its own field (every day's copy edits the same
  // time), in a plain element rather than a <button>, as for the submit button.
  const slotsHTML = slotList
    .map((s, i) =>
      editingPage
        ? '<span class="slot"><strong>' + s.day + '</strong><span data-edit="contactPage.slotTimes.' +
          (i % TIMES.length) + '" data-edit-kind="text">' + textHtml(s.time) + '</span></span>'
        : '<button type="button" class="slot" role="radio" aria-checked="false" data-i="' + i + '" tabindex="' +
          (i === 0 ? 0 : -1) + '"><strong>' + s.day + '</strong>' + textHtml(s.time) + '</button>'
    )
    .join('');
  let chosenSlot = -1;

  function pickSlot(i: number, focus?: boolean) {
    chosenSlot = i;
    $$('.slot').forEach((b, j) => {
      b.setAttribute('aria-checked', String(j === i));
      b.tabIndex = j === i ? 0 : -1;
      if (j === i && focus) b.focus();
    });
    clearErr('f-slot');
  }

  /* ---------- Form ---------- */
  function setErr(id: string, msg: string) {
    const f = document.getElementById(id)!;
    f.setAttribute('data-invalid', '');
    const e = $('.err', f);
    e.textContent = msg;
    e.hidden = false;
  }
  function clearErr(id: string) {
    const f = document.getElementById(id);
    if (!f) return;
    f.removeAttribute('data-invalid');
    $('.err', f).hidden = true;
  }

  const formWrap = $('#formWrap');
  const formHTML = formWrap.innerHTML;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  function handleSubmit(e: Event) {
    e.preventDefault();
    const v = { name: val('name'), biz: val('biz'), type: val('type'), contact: val('contact'), problem: val('problem') };
    let firstBad: string | null = null;
    const bad = (id: string, msg: string) => {
      setErr(id, msg);
      if (!firstBad) firstBad = id;
    };
    if (!v.name) bad('f-name', msg.errors.name);
    if (!v.biz) bad('f-biz', msg.errors.biz);
    if (!v.type) bad('f-type', msg.errors.type);
    const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.contact);
    const isHandle = /^@?[A-Za-z0-9._]{2,30}$/.test(v.contact);
    if (!v.contact) bad('f-contact', msg.errors.contact);
    else if (!isEmail && !isHandle) bad('f-contact', msg.errors.contactFormat);
    if (v.problem.length < 15) bad('f-problem', msg.errors.problem);
    if (chosenSlot < 0) bad('f-slot', msg.errors.slot);
    if (firstBad) {
      const el = document.querySelector<HTMLElement>(
        '#' + firstBad + ' input, #' + firstBad + ' select, #' + firstBad + ' textarea, #' + firstBad + ' .slot'
      );
      if (el) el.focus();
      return;
    }
    const slot = slotList[chosenSlot];
    const ref = 'No. AV-' + String(Math.floor(1000 + Math.random() * 9000));
    const topic = v.problem.length > 38 ? v.problem.slice(0, 36).trim() + '…' : v.problem;
    try {
      sessionStorage.removeItem(PREFILL_KEY);
    } catch {
      // Storage unavailable: nothing to clear.
    }
    formWrap.innerHTML =
      '<div class="confirm">' +
      '<p class="label">' + escapeHtml(msg.confirm.label) + '</p>' +
      '<h2 class="d-m">' + richHtml(fill(msg.confirm.headline, { name: v.name.split(' ')[0] }), { emClass: true }) + '</h2>' +
      '<p class="body-s" style="color:var(--ink-muted)">' +
      escapeHtml(fill(msg.confirm.body, { channel: isEmail ? msg.confirm.channelEmail : msg.confirm.channelDm })) +
      '</p>' +
      '<div class="confirm-ground"><div class="receipt receipt--dark">' +
      receiptHTML({
        number: ref,
        lines: [
          { l: msg.confirm.lineBusiness, v: v.biz },
          { l: msg.confirm.lineType, v: v.type },
          { l: msg.confirm.lineCall, v: slot.day + ', ' + slot.time },
          { l: msg.confirm.lineAbout, v: topic },
          { l: msg.confirm.lineCost, v: msg.confirm.costValue, hl: true },
        ],
        finding: msg.confirm.finding,
        footer: msg.confirm.footer,
      }) +
      '</div></div>' +
      '<button type="button" class="btn btn--forest" id="again">' + escapeHtml(msg.confirm.again) + '</button>' +
      '</div>';
    $('#again').addEventListener('click', resetForm);
    formWrap.scrollIntoView({ block: 'start' });
  }

  function resetForm() {
    formWrap.innerHTML = formHTML;
    bindForm();
    chosenSlot = -1;
    $('#name').focus();
  }

  function bindForm() {
    $('#slots').innerHTML = slotsHTML;
    $('#consultForm').addEventListener('submit', handleSubmit);
    ['name', 'biz', 'type', 'contact', 'problem'].forEach((k) => {
      const el = document.getElementById(k)!;
      el.addEventListener('input', () => clearErr('f-' + k));
      el.addEventListener('change', () => clearErr('f-' + k));
    });
    $('#slots').addEventListener('click', (e) => {
      const b = (e.target as Element).closest('.slot');
      if (b) pickSlot(+b.getAttribute('data-i')!);
    });
    $('#slots').addEventListener('keydown', (e) => {
      const cur = Math.max(0, chosenSlot);
      const n = slotList.length;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        pickSlot((cur + 1) % n, true);
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        pickSlot((cur - 1 + n) % n, true);
      }
    });
  }
  if (editingPage) $('#slots').innerHTML = slotsHTML;
  else bindForm();

  // Picks carried over from the home page's self-check.
  if (!editingPage) try {
    const prefill = sessionStorage.getItem(PREFILL_KEY);
    const ta = $<HTMLTextAreaElement>('#problem');
    if (prefill && !ta.value.trim()) ta.value = prefill;
  } catch {
    // Storage unavailable: start with an empty field.
  }

  /* ---------- Copy handle ---------- */
  let toastT: ReturnType<typeof setTimeout>;
  function toast(msg: string) {
    const t = $('#toast');
    t.textContent = msg;
    t.hidden = false;
    clearTimeout(toastT);
    toastT = setTimeout(() => {
      t.hidden = true;
    }, 2200);
  }
  if (!editingPage) $('#copyHandle').addEventListener('click', () => {
    const handle = $('.handle code').textContent || '';
    const p = navigator.clipboard?.writeText ? navigator.clipboard.writeText(handle) : Promise.reject();
    p.then(() => toast(fill(msg.toastCopied, { handle }))).catch(() => {
      const r = document.createRange();
      r.selectNodeContents($('.handle code'));
      const s = getSelection()!;
      s.removeAllRanges();
      s.addRange(r);
      toast(msg.toastSelected);
    });
  });
</script>
