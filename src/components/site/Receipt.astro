---
import { receiptHTML, type ReceiptData } from '../../lib/receipt';
import { isEditing } from '../../lib/editable';

export type Props = {
  data: ReceiptData;
  /** Shadow for the ground it sits on: hero (forest, beside the hero), dark (forest/ink), rose. */
  variant: 'hero' | 'dark' | 'rose';
  id?: string;
  label?: string;
  live?: boolean;
  /** Dot path of `data` in avise.json, for the editor's hooks. */
  editPath?: string;
};

const { data, variant, id, label, live, editPath } = Astro.props;
const editBase = isEditing(Astro.locals) ? editPath : undefined;
---

<div
  id={id}
  class={`receipt receipt--${variant}`}
  aria-label={label}
  aria-live={live ? 'polite' : undefined}
  set:html={receiptHTML(data, editBase)}
/>
