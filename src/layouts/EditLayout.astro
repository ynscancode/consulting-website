---
// Shell for every /edit/** page. Renders the SAME header, footer and page
// views as the public site (src/layouts/SiteLayout.astro), so the editor
// looks exactly like the live site, plus the editing toolbar and the
// editor-only stylesheet. Keep the <head> in sync with SiteLayout by hand.
import '../styles/avise.css';
import '../styles/editor.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import type { NavKey, Ground } from '../components/site/SiteHeader.astro';

export type Props = {
  title: string;
  current?: NavKey;
  ground?: Ground;
  showCta?: boolean;
  /** Editor page key: labels the save commit / history badge. */
  page: string;
  /** False on screens that aren't a site page (version history). */
  sitePage?: boolean;
  readonly?: boolean;
};

const { title, current, ground = 'forest', showCta = true, page, sitePage = true, readonly = false } = Astro.props;
const seed = JSON.stringify({ content: Astro.locals.aviseContent, page, readonly }).replace(/</g, '\\u003c');
---

<html lang="en-SG" data-editing>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4d37" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Editing · Avisé & Co.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader current={current} ground={ground} hideCta={!showCta} />
    <main id="main">
      <slot />
    </main>
    {sitePage && <SiteFooter showCta={showCta} />}
    <div class="toast" id="toast" role="status" hidden></div>
    <slot name="editor-toolbar" />
    {sitePage && <script type="application/json" id="editorSeed" set:html={seed} />}
    <script>
      import '../lib/editor/surface';
    </script>
  </body>
</html>
