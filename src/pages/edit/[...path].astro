---
// The inline editor. prerender=false so this can read Astro.locals.session
// (populated by src/middleware.ts) at request time; middleware already
// returns a generic 404 for any /edit/** request without a valid session,
// but this route re-checks defensively so the page itself never assumes it
// was reached legitimately (same generic response either way, KB-0007).
//
// URL scheme mirrors the public site, so every page is edited in place:
//   /edit                  -> home
//   /edit/services         -> what we do
//   /edit/approach         -> how we work
//   /edit/insights         -> insights list
//   /edit/insights/<id>    -> one insight
//   /edit/about            -> about
//   /edit/contact          -> free consult
//   /edit/history          -> version history
//
// Each page renders the SAME view component as the public route, fed the
// draft content and with edit hooks on (src/lib/editable.ts).
export const prerender = false;

import { loadAviseJson } from '../../lib/draftContent';
import EditLayout from '../../layouts/EditLayout.astro';
import EditorHarness from '../../components/EditorHarness.astro';
import EditHistory from '../../components/edit/EditHistory.astro';
import HomeView from '../../components/site/views/HomeView.astro';
import ServicesView from '../../components/site/views/ServicesView.astro';
import ApproachView from '../../components/site/views/ApproachView.astro';
import InsightsView from '../../components/site/views/InsightsView.astro';
import ArticleView from '../../components/site/views/ArticleView.astro';
import AboutView from '../../components/site/views/AboutView.astro';
import ContactView from '../../components/site/views/ContactView.astro';
import type { NavKey, Ground } from '../../components/site/SiteHeader.astro';

function notFound(): Response {
  return new Response('Not found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

if (!Astro.locals.session) {
  return notFound();
}

const segments = (Astro.params.path ?? '').split('/').filter(Boolean);
const [area, sub, extra] = segments;
if (extra) return notFound();

type View = 'home' | 'services' | 'approach' | 'insights' | 'article' | 'about' | 'contact' | 'history';
const PAGES: Record<string, { view: View; title: string; current?: NavKey }> = {
  '': { view: 'home', title: 'Home' },
  services: { view: 'services', title: 'What we do', current: 'services' },
  approach: { view: 'approach', title: 'How we work', current: 'approach' },
  insights: { view: 'insights', title: 'Insights', current: 'insights' },
  about: { view: 'about', title: 'About', current: 'about' },
  contact: { view: 'contact', title: 'Free consult' },
  history: { view: 'history', title: 'Version history' },
};

const pageDef = !sub ? PAGES[area ?? ''] : area === 'insights' ? { view: 'article' as View, title: 'Insight', current: 'insights' as NavKey } : undefined;
if (!pageDef) return notFound();

// Version history fetches its data client-side; every other page needs the draft.
const loaded = pageDef.view === 'history' ? null : await loadAviseJson();
const contentSource = loaded?.source ?? 'draft';
// Editing on every editor page: header and footer links stay inside /edit.
Astro.locals.editing = true;
if (loaded) Astro.locals.aviseContent = loaded.data;

let insightIndex = -1;
if (pageDef.view === 'article') {
  insightIndex = loaded!.data.insights.findIndex((item) => item.id === sub);
  if (insightIndex < 0) return notFound();
}
const insight = insightIndex >= 0 ? loaded!.data.insights[insightIndex] : undefined;

const title = insight ? insight.headline : pageDef.title;
const ground: Ground = pageDef.view === 'article' || pageDef.view === 'history' ? 'paper' : 'forest';
const page = pageDef.view === 'article' ? 'insights' : pageDef.view === 'history' ? 'site' : pageDef.view;
---

<EditLayout
  title={title}
  current={pageDef.current}
  ground={ground}
  showCta={pageDef.view !== 'contact'}
  page={page}
  sitePage={pageDef.view !== 'history'}
  readonly={contentSource === 'build'}
>
  {pageDef.view === 'home' && <HomeView />}
  {pageDef.view === 'services' && <ServicesView />}
  {pageDef.view === 'approach' && <ApproachView />}
  {pageDef.view === 'insights' && <InsightsView />}
  {pageDef.view === 'article' && insight && <ArticleView insight={insight} index={insightIndex} />}
  {pageDef.view === 'about' && <AboutView />}
  {pageDef.view === 'contact' && <ContactView />}
  {pageDef.view === 'history' && <EditHistory />}

  <EditorHarness slot="editor-toolbar" contentSource={contentSource} />
</EditLayout>
