---
import SiteLayout from '../layouts/SiteLayout.astro';
import Receipt from '../components/site/Receipt.astro';
import Steps from '../components/site/Steps.astro';
import InsightCard from '../components/site/InsightCard.astro';
import SelfCheck from '../components/site/SelfCheck.astro';
import { content } from '../lib/aviseContent';

const { heroReceipt, services, steps, insights, symptoms, areas, findings } = content;
---

<SiteLayout description="Practical strategy for Singapore small businesses. We do the homework on your business first, then bring you one thing you did not already know.">
  <section class="band band--forest on-dark">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">Practical strategy for Singapore small businesses</p>
        <h1 class="d-xl">Made for owners. We'll tell you <em class="em">straight.</em></h1>
        <p class="lede">We do the homework on your business first, then bring you one thing you did not already know.</p>
        <div class="btn-row" id="heroCta">
          <a class="btn btn--act" href="/contact">Book a free consult</a>
          <a class="btn btn--outline" href="/services">See what we do</a>
        </div>
        <p class="caption muted">Video call, about [30] minutes. No pitch deck, promise.</p>
      </div>
      <Receipt variant="hero" label="What the free consultation includes" data={heroReceipt} />
    </div>
  </section>

  <section class="band band--paper on-light">
    <div class="wrap">
      <div class="section-head">
        <p class="label">What we do</p>
        <h2 class="d-l">Three problems we solve <em class="em">well.</em></h2>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <div class="service">
              <h3 class="d-s">{s.name}</h3>
              <p class="body-s" style="color:var(--ink-muted)">
                {s.short}
              </p>
              <ul>
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <a class="more text-link" href={`/services#svc-${s.id}`}>
                More on this →
              </a>
            </div>
          ))
        }
      </div>
      <div class="note-row">
        <strong>Strategy only.</strong>
        <span>We don't make your posts or run your ads. We tell you which ones are worth making.</span>
      </div>
    </div>
  </section>

  <SelfCheck symptoms={symptoms} areas={areas} findings={findings} />

  <section class="band band--ink on-dark">
    <div class="wrap how-grid">
      <div class="stack">
        <p class="label">How we work</p>
        <h2 class="d-l">Diagnose first. Then <em class="em">fix.</em></h2>
        <p class="lede muted">The free consult names the problem. The project fixes it. You decide in between.</p>
        <div><a class="btn btn--outline" href="/approach">The full process</a></div>
      </div>
      <Steps steps={steps} />
    </div>
  </section>

  <section class="band band--paper on-light">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack" style="gap:var(--space-2)">
          <p class="label">Insights</p>
          <h2 class="d-l">Receipts for every <em class="em">claim.</em></h2>
        </div>
        <a class="text-link" href="/insights" style="font-weight:500">All insights →</a>
      </div>
      <div class="cards">
        {insights.map((a) => <InsightCard insight={a} />)}
      </div>
    </div>
  </section>
</SiteLayout>
