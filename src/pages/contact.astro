---
import SiteLayout from '../layouts/SiteLayout.astro';
import Faq from '../components/site/Faq.astro';
import { content } from '../lib/aviseContent';

const { faqContact } = content;

const businessTypes = [
  'Retail',
  'Thrift and vintage',
  'F&B',
  'Beauty and wellness',
  'Services and studios',
  'Online or D2C',
  'Something else',
];
---

<SiteLayout
  title="Book a free consult"
  showCta={false}
  description="Tell us what's wrong. Any problem. We read up on you first, then spend the free video call on what we found."
>
  <section class="band band--forest band--tight on-dark">
    <div class="wrap page-hero">
      <p class="label">Free consult</p>
      <h1 class="d-xl">Tell us what's <em class="em">wrong.</em></h1>
      <p class="lede">
        Any problem. You don't need to know the cause. We read up on you first, then spend the call on what we found.
      </p>
    </div>
  </section>
  <section class="band band--paper on-light">
    <div class="wrap form-grid">
      <div id="formWrap">
        <form id="consultForm" novalidate>
          <div class="field-row">
            <div class="field" id="f-name">
              <label for="name">Your name</label>
              <input id="name" name="name" autocomplete="name" />
              <span class="err" hidden></span>
            </div>
            <div class="field" id="f-biz">
              <label for="biz">Business name</label>
              <input id="biz" name="biz" autocomplete="organization" />
              <span class="err" hidden></span>
            </div>
          </div>
          <div class="field-row">
            <div class="field" id="f-type">
              <label for="type">Type of business</label>
              <select id="type" name="type">
                <option value="">Choose one</option>
                {businessTypes.map((t) => <option>{t}</option>)}
              </select>
              <span class="err" hidden></span>
            </div>
            <div class="field" id="f-contact">
              <label for="contact">Email or Instagram handle</label>
              <input id="contact" name="contact" autocomplete="email" placeholder="you@shop.sg or @yourshop" />
              <span class="err" hidden></span>
            </div>
          </div>
          <div class="field" id="f-problem">
            <label for="problem">What's going on?</label>
            <span class="hint">Describe it how you'd tell a friend. Two or three sentences is plenty.</span>
            <textarea id="problem" name="problem"></textarea>
            <span class="err" hidden></span>
          </div>
          <fieldset class="field" id="f-slot">
            <legend>Pick a time for the video call</legend>
            <span class="hint">Singapore time. We'll confirm by message.</span>
            <div class="slots" id="slots" role="radiogroup" aria-label="Available times"></div>
            <span class="err" hidden></span>
          </fieldset>
          <div class="btn-row">
            <button class="btn btn--forest" type="submit">Request my consult</button>
            <span class="caption" style="color:var(--ink-muted)">Free, and no obligation to hire us.</span>
          </div>
        </form>
      </div>
      <aside class="aside">
        <div class="stack">
          <p class="label">Rather message?</p>
          <div class="handle"><code>@avise.co</code><button class="copy-btn" type="button" id="copyHandle">Copy handle</button></div>
          <p class="body-s muted">DM us any problem on Instagram and we'll set up the call from there.</p>
        </div>
        <div class="stack">
          <p class="label">What happens next</p>
          <ul class="ticks">
            <li>We read up on your business before the call</li>
            <li>On the call, we name the likely cause and the ways to fix it</li>
            <li>If a project makes sense, we send one short brief and a quote</li>
          </ul>
        </div>
        <Faq items={faqContact} />
      </aside>
    </div>
  </section>
</SiteLayout>

<script>
  import { receiptHTML, escapeHtml } from '../lib/receipt';
  import { PREFILL_KEY } from '../lib/prefill';

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));

  /* ---------- Booking slots: the next four days after today, Sundays skipped ---------- */
  const TIMES = ['10:00 am', '3:00 pm', '8:00 pm'];
  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const slotList: { day: string; time: string }[] = [];
  {
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    let days = 0;
    while (days < 4) {
      d.setDate(d.getDate() + 1);
      if (d.getDay() === 0) continue;
      const label = DAYS[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()];
      TIMES.forEach((t) => slotList.push({ day: label, time: t }));
      days++;
    }
  }
  const slotsHTML = slotList
    .map(
      (s, i) =>
        '<button type="button" class="slot" role="radio" aria-checked="false" data-i="' + i + '" tabindex="' +
        (i === 0 ? 0 : -1) + '"><strong>' + s.day + '</strong>' + s.time + '</button>'
    )
    .join('');
  let chosenSlot = -1;

  function pickSlot(i: number, focus?: boolean) {
    chosenSlot = i;
    $$('.slot').forEach((b, j) => {
      b.setAttribute('aria-checked', String(j === i));
      b.tabIndex = j === i ? 0 : -1;
      if (j === i && focus) b.focus();
    });
    clearErr('f-slot');
  }

  /* ---------- Form ---------- */
  function setErr(id: string, msg: string) {
    const f = document.getElementById(id)!;
    f.setAttribute('data-invalid', '');
    const e = $('.err', f);
    e.textContent = msg;
    e.hidden = false;
  }
  function clearErr(id: string) {
    const f = document.getElementById(id);
    if (!f) return;
    f.removeAttribute('data-invalid');
    $('.err', f).hidden = true;
  }

  const formWrap = $('#formWrap');
  const formHTML = formWrap.innerHTML;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  function handleSubmit(e: Event) {
    e.preventDefault();
    const v = { name: val('name'), biz: val('biz'), type: val('type'), contact: val('contact'), problem: val('problem') };
    let firstBad: string | null = null;
    const bad = (id: string, msg: string) => {
      setErr(id, msg);
      if (!firstBad) firstBad = id;
    };
    if (!v.name) bad('f-name', 'Add your name so we know who to ask for.');
    if (!v.biz) bad('f-biz', 'Add your business name. We read up on it before the call.');
    if (!v.type) bad('f-type', 'Choose the closest type. "Something else" is fine.');
    const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.contact);
    const isHandle = /^@?[A-Za-z0-9._]{2,30}$/.test(v.contact);
    if (!v.contact) bad('f-contact', 'Add an email or Instagram handle so we can confirm the time.');
    else if (!isEmail && !isHandle) bad('f-contact', 'That doesn’t look like an email or a handle. Try you@shop.sg or @yourshop.');
    if (v.problem.length < 15) bad('f-problem', 'Tell us a little more. One or two sentences is enough.');
    if (chosenSlot < 0) bad('f-slot', 'Pick a time that suits you.');
    if (firstBad) {
      const el = document.querySelector<HTMLElement>(
        '#' + firstBad + ' input, #' + firstBad + ' select, #' + firstBad + ' textarea, #' + firstBad + ' .slot'
      );
      if (el) el.focus();
      return;
    }
    const slot = slotList[chosenSlot];
    const ref = 'No. AV-' + String(Math.floor(1000 + Math.random() * 9000));
    const topic = v.problem.length > 38 ? v.problem.slice(0, 36).trim() + '…' : v.problem;
    try {
      sessionStorage.removeItem(PREFILL_KEY);
    } catch {
      // Storage unavailable: nothing to clear.
    }
    formWrap.innerHTML =
      '<div class="confirm">' +
      '<p class="label">Request received</p>' +
      '<h2 class="d-m">Thanks, ' + escapeHtml(v.name.split(' ')[0]) + '. We’ll do our <em class="em">homework.</em></h2>' +
      '<p class="body-s" style="color:var(--ink-muted)">We’ll confirm your slot by ' + (isEmail ? 'email' : 'Instagram DM') +
      ' within [one working day].</p>' +
      '<div class="confirm-ground"><div class="receipt receipt--dark">' +
      receiptHTML({
        number: ref,
        lines: [
          { l: 'Business', v: v.biz },
          { l: 'Type', v: v.type },
          { l: 'Call', v: slot.day + ', ' + slot.time },
          { l: 'About', v: topic },
          { l: 'Cost to you', v: 'S$0.00', hl: true },
        ],
        finding: 'See you on the <em>call.</em>',
        footer: 'Prototype: this request was not sent.',
      }) +
      '</div></div>' +
      '<button type="button" class="btn btn--forest" id="again">Start another request</button>' +
      '</div>';
    $('#again').addEventListener('click', resetForm);
    formWrap.scrollIntoView({ block: 'start' });
  }

  function resetForm() {
    formWrap.innerHTML = formHTML;
    bindForm();
    chosenSlot = -1;
    $('#name').focus();
  }

  function bindForm() {
    $('#slots').innerHTML = slotsHTML;
    $('#consultForm').addEventListener('submit', handleSubmit);
    ['name', 'biz', 'type', 'contact', 'problem'].forEach((k) => {
      const el = document.getElementById(k)!;
      el.addEventListener('input', () => clearErr('f-' + k));
      el.addEventListener('change', () => clearErr('f-' + k));
    });
    $('#slots').addEventListener('click', (e) => {
      const b = (e.target as Element).closest('.slot');
      if (b) pickSlot(+b.getAttribute('data-i')!);
    });
    $('#slots').addEventListener('keydown', (e) => {
      const cur = Math.max(0, chosenSlot);
      const n = slotList.length;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        pickSlot((cur + 1) % n, true);
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        pickSlot((cur - 1 + n) % n, true);
      }
    });
  }
  bindForm();

  // Picks carried over from the home page's self-check.
  try {
    const prefill = sessionStorage.getItem(PREFILL_KEY);
    const ta = $<HTMLTextAreaElement>('#problem');
    if (prefill && !ta.value.trim()) ta.value = prefill;
  } catch {
    // Storage unavailable: start with an empty field.
  }

  /* ---------- Copy handle ---------- */
  let toastT: ReturnType<typeof setTimeout>;
  function toast(msg: string) {
    const t = $('#toast');
    t.textContent = msg;
    t.hidden = false;
    clearTimeout(toastT);
    toastT = setTimeout(() => {
      t.hidden = true;
    }, 2200);
  }
  $('#copyHandle').addEventListener('click', () => {
    const p = navigator.clipboard?.writeText ? navigator.clipboard.writeText('@avise.co') : Promise.reject();
    p.then(() => toast('Copied @avise.co')).catch(() => {
      const r = document.createRange();
      r.selectNodeContents($('.handle code'));
      const s = getSelection()!;
      s.removeAllRanges();
      s.addRange(r);
      toast('Selected. Copy it with your keyboard.');
    });
  });
</script>
