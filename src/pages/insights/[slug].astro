---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleView from '../../components/site/views/ArticleView.astro';
import { content, type Insight } from '../../lib/aviseContent';

export function getStaticPaths() {
  return content.insights.map((insight, index) => ({ params: { slug: insight.id }, props: { insight, index } }));
}

const { insight, index } = Astro.props as { insight: Insight; index: number };
---

<SiteLayout title={insight.headline} current="insights" ground="paper" description={insight.lede}>
  <ArticleView insight={insight} index={index} />
</SiteLayout>
